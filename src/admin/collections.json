{
  "about": {
    "label": "Giới thiệu",
    "kind": "perLocaleFiles",
    "body": true
  },
  "posts": {
    "label": "Bài viết",
    "label_singular": "Bài",
    "kind": "entries",
    "summary": "{{title}}",
    "sortable_fields": ["date"],
    "i18n": true,
    "slug": {
      "template": "{{slug}}"
    },
    "body": true,
    "extension": "mdx",
    "display_field": "title"
  },
  "home": {
    "label": "Trang chủ",
    "kind": "single"
  },
  "roles": {
    "label": "Vai trò",
    "label_singular": "Vai trò",
    "kind": "entries",
    "summary": "{{fields.start}}–{{fields.end}} · {{fields.role.$source}}, {{fields.org.$source}}",
    "sortable_fields": ["order"],
    "display_field": "role.$source"
  },
  "entries": {
    "label": "Dòng thời gian",
    "label_singular": "Mục",
    "kind": "entries",
    "summary": "{{fields.year}} · {{fields.title.$source}}",
    "sortable_fields": ["order"],
    "display_field": "title.$source"
  },
  "credentials": {
    "label": "Chứng chỉ",
    "kind": "entries",
    "summary": "{{fields.year}} · {{fields.title.$source}}",
    "display_field": "title.$source"
  },
  "outlets": {
    "label": "Đơn vị đăng",
    "kind": "entries",
    "summary": "{{fields.name.$source}} (tier {{fields.tier}})",
    "display_field": "name.$source"
  },
  "references": {
    "label": "Nguồn",
    "kind": "entries",
    "summary": "{{fields.outlet}} — {{fields.title}}",
    "sortable_fields": ["date"],
    "display_field": "title"
  },
  "strings": {
    "label": "Chuỗi giao diện",
    "kind": "strings"
  },
  "site": {
    "label": "Thông tin site",
    "kind": "single"
  }
}
