{
  "about": {
    "label": "Giới thiệu",
    "kind": "file",
    "file": "about/{{locale}}.mdx",
    "body": true
  },
  "posts": {
    "label": "Bài viết",
    "label_singular": "Bài",
    "kind": "entries",
    "summary": "{{title}}",
    "sortable_fields": ["date"],
    "perLocaleFiles": true,
    "slug": {
      "template": "{{slug}}"
    },
    "body": true,
    "extension": "mdx",
    "display_field": "title"
  },
  "home": {
    "label": "Trang chủ",
    "kind": "file",
    "file": "home.json"
  },
  "roles": {
    "label": "Vai trò",
    "label_singular": "Vai trò",
    "kind": "entries",
    "summary": "{{fields.start}}–{{fields.end}} · {{fields.role}}, {{fields.org}}",
    "sortable_fields": ["order"],
    "display_field": "role"
  },
  "entries": {
    "label": "Dòng thời gian",
    "label_singular": "Mục",
    "kind": "entries",
    "summary": "{{fields.year}} · {{fields.title}}",
    "sortable_fields": ["order"],
    "display_field": "title"
  },
  "credentials": {
    "label": "Chứng chỉ",
    "kind": "entries",
    "summary": "{{fields.year}} · {{fields.title}}",
    "display_field": "title",
    "media_folder": "/src/assets/certs",
    "public_folder": "@/assets/certs",
    "files": {
      "media_folder": "/public/certs",
      "public_folder": "/certs"
    }
  },
  "outlets": {
    "label": "Đơn vị đăng",
    "kind": "entries",
    "summary": "{{fields.name}} (tier {{fields.tier}})",
    "display_field": "name",
    "media_folder": "/src/assets/logos",
    "public_folder": "@/assets/logos"
  },
  "references": {
    "label": "Nguồn",
    "kind": "entries",
    "summary": "{{fields.outlet}} · {{fields.title}}",
    "sortable_fields": ["date"],
    "display_field": "title"
  },
  "strings": {
    "label": "Chuỗi giao diện",
    "kind": "strings",
    "file": "strings/{{locale}}.json"
  },
  "site": {
    "label": "Thông tin site",
    "kind": "file",
    "file": "site.json",
    "files": {
      "media_folder": "/public/media",
      "public_folder": "/media"
    }
  }
}
