{
  "backend": {
    "name": "github",
    "repo": "minh-vt/minh-vt",
    "branch": "main",
    "base_url": "https://auth.minhvt.id.vn"
  },
  "media_folder": "src/assets/media",
  "public_folder": "@/assets/media",
  "publish_mode": "simple",
  "slug": {
    "encoding": "ascii",
    "clean_accents": true
  },
  "output": {
    "omit_empty_optional_fields": true
  },
  "media_libraries": {
    "default": {
      "config": {
        "slugify_filename": true,
        "transformations": {
          "raster_image": {
            "format": "webp",
            "quality": 85,
            "width": 2000,
            "height": 2000
          }
        }
      }
    }
  }
}
