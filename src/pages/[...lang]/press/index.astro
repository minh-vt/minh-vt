---
import Base from '@/layouts/Base.astro'
import PageHeader from '@/components/PageHeader.astro'
import PressList from '@/components/PressList.astro'
import { routeLocale } from '@/i18n/locales'
import { pathFor, useTranslations } from '@/i18n/utils'
import { localeParams } from '@/i18n/routes'
import { getCredentials, getEntries, getReferences, pressOf } from '@/lib/content'

export function getStaticPaths() {
  return localeParams()
}

const lang = routeLocale(Astro.params.lang)
const t = useTranslations(lang)
const references = await getReferences(lang)
const entries = await getEntries(lang, references, await getCredentials(lang))
---

<Base lang={lang} title={t('area.press.title')} description={t('area.press.lead')}>
  <div class="u-wrap pb-16">
    <PageHeader
      title={t('area.press.title')}
      lead={t('area.press.lead')}
      back={{ href: pathFor(lang), label: t('nav.home') }}
    />
    <PressList {lang} items={pressOf(references)} {entries} />
  </div>
</Base>
