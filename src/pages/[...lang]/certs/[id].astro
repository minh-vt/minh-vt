---
import Base from '@/layouts/Base.astro'
import Lightbox from '@/components/Lightbox.svelte'
import PageHeader from '@/components/PageHeader.astro'
import { lightboxPhotos } from '@/lib/images'
import { routeLocale } from '@/i18n/locales'
import { useTranslations, pathFor } from '@/i18n/utils'
import { localeParams } from '@/i18n/routes'
import {
  getCredentials,
  getEntries,
  getReferences,
  type CredentialRow,
  type EntryRow,
} from '@/lib/content'

export async function getStaticPaths() {
  const paths = await Promise.all(
    localeParams().map(async ({ params }) => {
      const lang = routeLocale(params.lang)
      const credentials = await getCredentials(lang)
      const entries = await getEntries(lang, await getReferences(), credentials)
      return credentials.map((item) => ({
        params: { lang: params.lang, id: item.id },
        props: {
          item,
          related: entries.filter((entry) => entry.credentials.includes(item)),
        },
      }))
    }),
  )
  return paths.flat()
}

interface Props {
  item: CredentialRow
  related: EntryRow[]
}

const { item, related } = Astro.props
const lang = routeLocale(Astro.params.lang)
const t = useTranslations(lang)
const files = [item.file, ...(item.extra ? [item.extra] : [])]
---

<!-- A credential gets a page of its own; the original file opens from here. -->
<Base lang={lang} title={item.title} description={`${item.title} · ${item.issuer}`}>
  <div class="u-wrap pb-16">
    <PageHeader
      title={item.title}
      lead={`${item.issuer} · ${item.year}`}
      back={{ href: pathFor(lang, 'certs'), label: t('area.certs.title') }}
    />

    <div class="mt-8 grid items-start gap-8 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <Lightbox
        client:visible
        photos={await lightboxPhotos(
          [item.preview],
          item.title,
          '(min-width: 52em) 40rem, 100vw',
        )}
        labels={{
          zoom: t('photo.zoom'),
          close: t('nav.close'),
          previous: t('photo.previous'),
          next: t('photo.next'),
        }}
      />
      <div class="flex flex-col items-start gap-6">
        <ul class="flex flex-col gap-2">
          {
            files.map((file, index) => (
              <li>
                <a href={file} class="btn">
                  <span class="i-ph-file-arrow-down" aria-hidden="true" />
                  {index === 0 ? t('certs.open') : t('certs.extra')}
                </a>
              </li>
            ))
          }
        </ul>
        {
          related.length > 0 && (
            <div>
              <p class="t-label">{t('certs.related')}</p>
              <ul class="mt-1">
                {related.map((entry) => (
                  <li>
                    <a href={`${pathFor(lang, 'timeline')}#${entry.id}`} class="link">
                      {entry.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </div>
</Base>
