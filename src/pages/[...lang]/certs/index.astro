---
import Base from '@/layouts/Base.astro'
import CredentialGrid from '@/components/CredentialGrid.astro'
import PageHeader from '@/components/PageHeader.astro'
import { routeLocale } from '@/i18n/locales'
import { pathFor, useTranslations } from '@/i18n/utils'
import { localeParams } from '@/i18n/routes'
import { getCredentials } from '@/lib/content'

export function getStaticPaths() {
  return localeParams()
}

const lang = routeLocale(Astro.params.lang)
const t = useTranslations(lang)
const items = await getCredentials(lang)
---

<Base lang={lang} title={t('area.certs.title')} description={t('area.certs.lead')}>
  <div class="u-wrap pb-16">
    <PageHeader
      title={t('area.certs.title')}
      lead={t('area.certs.lead')}
      back={{ href: pathFor(lang), label: t('nav.home') }}
    />
    <CredentialGrid {lang} {items} byYear />
  </div>
</Base>
