---
import { render } from 'astro:content'
import Base from '@/layouts/Base.astro'
import Hero from '@/components/Hero.astro'
import HomeSection from '@/components/home/HomeSection.astro'
import CredentialGrid from '@/components/CredentialGrid.astro'
import EntryList from '@/components/EntryList.astro'
import PostList from '@/components/PostList.astro'
import PressList from '@/components/PressList.astro'
import { routeLocale } from '@/i18n/locales'
import { localeParams } from '@/i18n/routes'
import {
  getAbout,
  getCredentials,
  getCurrentRoles,
  getEntries,
  getPosts,
  getReferences,
  pickFeatured,
  pressOf,
} from '@/lib/content'
import { sections, siteFor } from '@/lib/site'
import { absolute, person } from '@/lib/seo'

export function getStaticPaths() {
  return localeParams()
}

const lang = routeLocale(Astro.params.lang)
const site = siteFor(lang)

// Loaded once and shared, so every section resolves the same objects.
const references = await getReferences(lang)
const credentials = await getCredentials(lang)
const entries = await getEntries(lang, references, credentials)
const press = pressOf(references)
const posts = await getPosts(lang)
const roles = await getCurrentRoles(lang)
const about = await getAbout(lang)
const { Content: AboutText } = await render(about.entry)

const { lead, updated } = about.entry.data
const jsonLd = {
  '@type': 'ProfilePage',
  ...(updated && { dateModified: updated.toISOString() }),
  mainEntity: {
    ...person(lang),
    description: lead,
    email: `mailto:${site.email}`,
    ...(site.portrait && { image: absolute(site.portrait.src) }),
    homeLocation: { '@type': 'Place', name: site.location },
    jobTitle: roles.map((role) => role.role),
    affiliation: roles.map((role) => ({
      '@type': 'Organization',
      name: role.org,
      ...(role.url && { url: role.url }),
    })),
    sameAs: site.links.map((link) => link.url),
  },
}
---

<!-- The homepage is a hub: a few featured items per area, each area its own page. -->
<Base lang={lang} description={lead} jsonLd={jsonLd}>
  <Hero {lang} {roles} />
  {
    sections.map((section) => {
      switch (section.type) {
        case 'about':
          return (
            <HomeSection {lang} area="about">
              <div class="prose mt-6" lang={about.lang}>
                <AboutText />
              </div>
            </HomeSection>
          )
        case 'press': {
          const items = pickFeatured(press, section.limit, (ref) => ref.featured)
          return (
            <HomeSection
              {lang}
              area="press"
              count={{ shown: items.length, total: press.length }}
            >
              <PressList {lang} {items} {entries} />
            </HomeSection>
          )
        }
        case 'timeline': {
          const items = pickFeatured(entries, section.limit, (entry) => entry.featured)
          return (
            <HomeSection
              {lang}
              area="timeline"
              count={{ shown: items.length, total: entries.length }}
            >
              <EntryList {lang} entries={items} />
            </HomeSection>
          )
        }
        case 'blog': {
          const items = pickFeatured(
            posts,
            section.limit,
            (post) => post.entry.data.featured,
          )
          return (
            <HomeSection
              {lang}
              area="blog"
              count={{ shown: items.length, total: posts.length }}
            >
              <PostList {lang} posts={items} />
            </HomeSection>
          )
        }
        case 'certs': {
          const items = pickFeatured(credentials, section.limit, (item) => item.featured)
          return (
            <HomeSection
              {lang}
              area="certs"
              count={{ shown: items.length, total: credentials.length }}
            >
              <CredentialGrid {lang} {items} />
            </HomeSection>
          )
        }
      }
    })
  }
</Base>
