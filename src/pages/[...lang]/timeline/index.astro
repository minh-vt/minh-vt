---
import Base from '@/layouts/Base.astro'
import EntryList from '@/components/EntryList.astro'
import PageHeader from '@/components/PageHeader.astro'
import { routeLocale } from '@/i18n/locales'
import { pathFor, useTranslations } from '@/i18n/utils'
import { localeParams } from '@/i18n/routes'
import { getCredentials, getEntries, getReferences } from '@/lib/content'

export function getStaticPaths() {
  return localeParams()
}

const lang = routeLocale(Astro.params.lang)
const t = useTranslations(lang)
const entries = await getEntries(lang, await getReferences(), await getCredentials(lang))
---

<Base lang={lang} title={t('area.timeline.title')} description={t('area.timeline.lead')}>
  <div class="u-wrap pb-16">
    <PageHeader
      title={t('area.timeline.title')}
      lead={t('area.timeline.lead')}
      back={{ href: pathFor(lang), label: t('nav.home') }}
    />
    <EntryList {lang} {entries} filters />
  </div>
</Base>
