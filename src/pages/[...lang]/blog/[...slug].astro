---
import { render } from 'astro:content'
import Post from '@/layouts/Post.astro'
import { routeLocale } from '@/i18n/locales'
import { local, pathFor } from '@/i18n/utils'
import { localeParams } from '@/i18n/routes'
import {
  entryLang,
  getPosts,
  neighbours,
  postSlug,
  readingMinutes,
  type LocalizedPost,
} from '@/lib/content'
import { site } from '@/lib/site'

export async function getStaticPaths() {
  const paths = await Promise.all(
    localeParams().map(async ({ params }) => {
      const lang = routeLocale(params.lang)
      const posts = await getPosts(lang)
      return posts.map((post) => ({
        params: { lang: params.lang, slug: postSlug(post.entry.id) },
        props: { post, ...neighbours(posts, postSlug(post.entry.id)) },
      }))
    }),
  )
  return paths.flat()
}

interface Props {
  post: LocalizedPost
  previous?: LocalizedPost
  next?: LocalizedPost
}
const { post, previous, next } = Astro.props
const lang = routeLocale(Astro.params.lang)
const contentLang = entryLang(post.entry.id)
const { Content, headings } = await render(post.entry)

const path = pathFor(lang, `blog/${postSlug(post.entry.id)}`)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.entry.data.title,
  description: post.entry.data.description,
  datePublished: post.entry.data.date.toISOString(),
  inLanguage: contentLang,
  author: {
    '@type': 'Person',
    name: local(site.name, contentLang),
    url: Astro.site ? new URL(pathFor(lang), Astro.site).href : undefined,
  },
  mainEntityOfPage: Astro.site ? new URL(path, Astro.site).href : path,
}
---

<Post
  lang={lang}
  contentLang={contentLang}
  title={post.entry.data.title}
  description={post.entry.data.description}
  date={post.entry.data.date}
  minutes={readingMinutes(post.entry.body)}
  origin={post.entry.data.origin}
  jsonLd={jsonLd}
  {headings}
  series={post.entry.data.series}
  {previous}
  {next}
>
  <Content />
</Post>
