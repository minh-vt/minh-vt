---
import { render } from 'astro:content'
import Post from '@/layouts/Post.astro'
import { routeLocale } from '@/i18n/locales'
import { pathFor } from '@/i18n/utils'
import { localeParams } from '@/i18n/routes'
import {
  entryLang,
  getPosts,
  postSlug,
  readingMinutes,
  type LocalizedPost,
} from '@/lib/content'
import { site } from '@/lib/site'

export async function getStaticPaths() {
  const paths = await Promise.all(
    localeParams().map(async ({ params }) => {
      const lang = routeLocale(params.lang)
      return (await getPosts(lang)).map((post) => ({
        params: { lang: params.lang, slug: postSlug(post.entry.id) },
        props: { post },
      }))
    }),
  )
  return paths.flat()
}

interface Props {
  post: LocalizedPost
}
const { post } = Astro.props
const lang = routeLocale(Astro.params.lang)
const contentLang = entryLang(post.entry.id)
const { Content, headings } = await render(post.entry)

const path = pathFor(lang, `blog/${postSlug(post.entry.id)}`)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.entry.data.title,
  description: post.entry.data.description,
  datePublished: post.entry.data.date.toISOString(),
  inLanguage: contentLang,
  author: { '@type': 'Person', name: 'Vũ Tùng Minh', url: site.github },
  mainEntityOfPage: Astro.site ? new URL(path, Astro.site).href : path,
}
---

<Post
  lang={lang}
  contentLang={contentLang}
  title={post.entry.data.title}
  description={post.entry.data.description}
  date={post.entry.data.date}
  minutes={readingMinutes(post.entry.body)}
  origin={post.entry.data.origin}
  jsonLd={jsonLd}
  {headings}
>
  <Content />
</Post>
