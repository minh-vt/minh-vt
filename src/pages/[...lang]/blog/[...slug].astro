---
import { render } from 'astro:content'
import Post from '@/layouts/Post.astro'
import Figure from '@/components/Figure.astro'
import { routeLocale } from '@/i18n/locales'
import { localeParams } from '@/i18n/routes'
import {
  entryLang,
  getPosts,
  neighbours,
  postPath,
  postSlug,
  readingMinutes,
  type LocalizedPost,
} from '@/lib/content'
import { siteImage } from '@/lib/assets'
import { site } from '@/lib/site'
import { absolute, person, shareImage } from '@/lib/seo'

export async function getStaticPaths() {
  const paths = await Promise.all(
    localeParams().map(async ({ params }) => {
      const lang = routeLocale(params.lang)
      const posts = await getPosts(lang)
      return posts.map((post) => ({
        params: { lang: params.lang, slug: postSlug(post.entry.id) },
        props: { post, ...neighbours(posts, postSlug(post.entry.id)) },
      }))
    }),
  )
  return paths.flat()
}

interface Props {
  post: LocalizedPost
  previous?: LocalizedPost
  next?: LocalizedPost
}
const { post, previous, next } = Astro.props
const lang = routeLocale(Astro.params.lang)
const contentLang = entryLang(post.entry.id)
const { Content, headings, remarkPluginFrontmatter } = await render(post.entry)
const { title, description, date, updated } = post.entry.data

const image = post.entry.data.image
  ? siteImage(post.entry.data.image, `posts/${post.entry.id} image`)
  : undefined
const share = image ?? site.shareImage ?? site.portrait
// Described in the language it is written in, at the URL it is written for.
const jsonLd = {
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  inLanguage: contentLang,
  author: person(contentLang),
  publisher: person(contentLang),
  ...(share && { image: (await shareImage(share)).url }),
  mainEntityOfPage: absolute(postPath(contentLang, post.entry.id)),
}
---

<Post
  lang={lang}
  contentLang={contentLang}
  {title}
  {description}
  {date}
  {image}
  translations={post.languages}
  math={Boolean(remarkPluginFrontmatter.math)}
  minutes={readingMinutes(post.entry.body)}
  origin={post.entry.data.origin}
  jsonLd={jsonLd}
  {headings}
  series={post.entry.data.series}
  {previous}
  {next}
>
  <Content components={{ Figure }} />
</Post>
