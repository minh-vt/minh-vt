---
import Base from '@/layouts/Base.astro'
import PageHeader from '@/components/PageHeader.astro'
import PostList from '@/components/PostList.astro'
import { routeLocale } from '@/i18n/locales'
import { pathFor, useTranslations } from '@/i18n/utils'
import { localeParams } from '@/i18n/routes'
import { getPosts } from '@/lib/content'

export function getStaticPaths() {
  return localeParams()
}

const lang = routeLocale(Astro.params.lang)
const t = useTranslations(lang)
const posts = await getPosts(lang)
---

<Base lang={lang} title={t('area.blog.title')} description={t('area.blog.lead')}>
  <div class="u-wrap pb-16">
    <PageHeader
      title={t('area.blog.title')}
      lead={t('area.blog.lead')}
      back={{ href: pathFor(lang), label: t('nav.home') }}
    />
    <PostList {lang} {posts} />
  </div>
</Base>
