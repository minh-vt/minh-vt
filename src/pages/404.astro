---
import NotFound from '@/components/NotFound.astro'
import { defaultLocale } from '@/i18n/locales'

/*
 * Astro treats only this file as the 404 page: it answers missing URLs in
 * `astro dev` and `astro preview`, and builds dist/404.html, which Cloudflare
 * Pages serves for any missing URL. Other locales: [...lang]/404.astro.
 */
---

<NotFound lang={defaultLocale} />
