---
import { render } from 'astro:content'
import Base from '@/layouts/Base.astro'
import Hero from '@/components/Hero.astro'
import SectionHead from '@/components/SectionHead.astro'
import FactList from '@/components/FactList.astro'
import Sources from '@/components/Sources.astro'
import { languages, type Lang } from '@/i18n/ui'
import { localePath, useTranslations } from '@/i18n/utils'
import {
  getAbout,
  getFacts,
  getPosts,
  getReferenceIndex,
  getReferences,
  local,
  postSlug,
  resolveRefs,
} from '@/lib/content'
import { site } from '@/lib/site'

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as Lang
const t = useTranslations(lang)

const about = await getAbout(lang)
const { Content } = await render(about.entry)

const refIndex = await getReferenceIndex()
const rows = (await getFacts()).map((fact) => ({
  id: fact.id,
  year: fact.data.year,
  title: local(fact.data.title, lang),
  summary: local(fact.data.summary, lang),
  metric: fact.data.metric ? local(fact.data.metric, lang) : undefined,
  refs: resolveRefs(fact.data.refs, refIndex),
}))
const sources = await getReferences()
const posts = (await getPosts(lang)).slice(0, 4)

const dateFormat = new Intl.DateTimeFormat(lang === 'vi' ? 'vi-VN' : 'en-GB', {
  year: 'numeric',
  month: 'short',
})

const facts = [
  { label: t('facts.basedIn'), value: site.location[lang] },
  { label: t('facts.now'), value: lang === 'vi' ? 'Kỹ sư nhúng, Science Lab' : 'Embedded engineer, Science Lab' },
  { label: t('facts.since'), value: '2018' },
]

const links = [
  { href: `mailto:${site.email}`, label: site.email },
  { href: site.github, label: 'GitHub' },
  { href: site.linkedin, label: 'LinkedIn' },
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Vũ Tùng Minh',
  alternateName: 'Vu Tung Minh',
  url: Astro.site ? new URL(localePath(lang), Astro.site).href : undefined,
  email: `mailto:${site.email}`,
  jobTitle: 'Embedded software engineer',
  sameAs: [site.github, site.linkedin],
  knowsAbout: ['embedded systems', 'GStreamer', 'LLM inference', 'robotics'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ho Chi Minh City',
    addressCountry: 'VN',
  },
}
---

<Base
  lang={lang}
  title={t('site.title')}
  description={t('meta.description')}
  jsonLd={jsonLd}
>
  <Hero
    lang={lang}
    name={t('site.name')}
    location={site.location[lang]}
    lead={about.entry.data.lead}
    links={links}
  />

  <section class="u-wrap u-section-tight">
    <div class="grid gap-8 md:grid-cols-[12rem_1fr] md:gap-12">
      <dl class="grid grid-cols-2 gap-x-6 gap-y-5 md:grid-cols-1 md:gap-5">
        {
          facts.map((fact) => (
            <div>
              <dt class="t-label">{fact.label}</dt>
              <dd class="t-meta mt-1 text-ink">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="prose" lang={about.lang} data-reveal>
        <Content />
      </div>
    </div>
  </section>

  <section id="timeline" class="u-wrap u-section">
    <SectionHead title={t('section.timeline')} lead={`${rows.length} ${lang === 'vi' ? 'mốc' : 'entries'}`} />
    <FactList lang={lang} rows={rows} />
  </section>

  <section id="writing" class="u-wrap u-section">
    <SectionHead title={t('section.writing')} lead={t('section.writing.lead')} />

    {
      posts.length === 0 ? (
        <p class="t-meta mt-6">{t('blog.empty')}</p>
      ) : (
        <ul class="mt-2">
          {posts.map((post, index) => (
            <li
              class="border-b border-line"
              data-reveal
              style={`--reveal-delay:${Math.min(index, 5) * 40}ms`}
            >
              <a
                href={localePath(lang, `blog/${postSlug(post.entry.id)}`)}
                class="u-focus grid grid-cols-[1fr_auto] items-baseline gap-4 py-4"
              >
                <span class="t-title" lang={post.lang}>
                  {post.entry.data.title}
                  {post.lang !== lang && (
                    <span class="t-meta"> · {languages[post.lang]}</span>
                  )}
                </span>
                <time class="t-meta" datetime={post.entry.data.date.toISOString()}>
                  {dateFormat.format(post.entry.data.date)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-6">
      <a href={localePath(lang, 'blog')} class="u-focus t-label text-ink hover:text-accent">
        {t('blog.back')} →
      </a>
    </p>
  </section>

  <section id="sources" class="u-section">
    <div class="u-wrap">
      <SectionHead title={t('section.sources')} lead={t('section.sources.lead')} />
    </div>
    <div class="mt-6">
      <Sources lang={lang} items={sources} />
    </div>
  </section>

  <section id="contact" class="u-invert scroll-mt-16">
    <div class="u-wrap u-section">
      <p class="t-label">{t('section.contact')}</p>
      <a
        href={`mailto:${site.email}`}
        class="u-focus t-email mt-4 block hover:text-accent"
        data-reveal
      >
        {site.email}
      </a>
      <p class="t-meta mt-5 max-w-[32rem]">{t('section.contact.lead')}</p>
    </div>
  </section>
</Base>
