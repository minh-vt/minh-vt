---
import Base from '../../../layouts/Base.astro'
import { languages, type Lang } from '../../../i18n/ui'
import { localePath, useTranslations } from '../../../i18n/utils'
import { getPosts } from '../../../lib/content'
import { elsewhere } from '../../../data/writing'

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as Lang
const t = useTranslations(lang)
const posts = await getPosts(lang)
const external = elsewhere[lang]
const dateFormat = new Intl.DateTimeFormat(lang === 'vi' ? 'vi-VN' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<Base
  lang={lang}
  title={`${t('section.writing')} · ${t('site.name')}`}
  description={t('section.writing.lead')}
>
  <div class="u-wrap pt-14 pb-20 md:pt-20">
    <header class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
      <h1 class="t-section">{t('section.writing')}</h1>
      <p class="t-meta">{t('section.writing.lead')}</p>
    </header>

    {
      posts.length === 0 ? (
        <p class="t-meta mt-10">{t('blog.empty')}</p>
      ) : (
        <ol class="mt-10">
          {posts.map((post) => (
            <li class="border-t border-line py-7 last:border-b" data-reveal>
              <div class="grid gap-2 md:grid-cols-[8rem_1fr] md:gap-8">
                <time class="t-meta pt-1" datetime={post.data.date.toISOString()}>
                  {dateFormat.format(post.data.date)}
                </time>
                <div>
                  <h2 class="t-title">
                    <a
                      href={localePath(
                        lang,
                        `blog/${post.id.split('/').slice(1).join('/')}`,
                      )}
                      class="u-focus no-underline hover:text-accent"
                    >
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="u-measure mt-2">{post.data.description}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
      )
    }

    <section class="mt-16">
      <h2 class="t-label">{t('blog.elsewhere')}</h2>
      <ol class="mt-4">
        {
          external.map((item) => (
            <li class="grid gap-x-8 gap-y-1 border-t border-line py-4 last:border-b md:grid-cols-[8rem_1fr]">
              <time class="t-meta" datetime={item.date}>
                {dateFormat.format(new Date(item.date))}
              </time>
              <div>
                <a
                  href={item.url}
                  class="u-focus underline decoration-line underline-offset-4 transition-colors duration-200 hover:text-accent hover:decoration-accent"
                  rel="noreferrer"
                >
                  {item.title}
                </a>
                <p class="t-meta mt-1">{item.outlet}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Base>
