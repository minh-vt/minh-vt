---
import { render } from 'astro:content'
import Post from '@/layouts/Post.astro'
import { languages, type Lang } from '@/i18n/ui'
import { localePath } from '@/i18n/utils'
import { entryLang, getPosts, postSlug, readingMinutes } from '@/lib/content'
import { site } from '@/lib/site'

export async function getStaticPaths() {
  const locales = Object.keys(languages) as Lang[]
  const perLocale = await Promise.all(
    locales.map(async (lang) =>
      (await getPosts(lang)).map((post) => ({
        params: { lang, slug: postSlug(post.entry.id) },
        props: { post },
      })),
    ),
  )
  return perLocale.flat()
}

const { post } = Astro.props
const lang = Astro.params.lang as Lang
const contentLang = entryLang(post.entry.id)
const { Content } = await render(post.entry)

const path = localePath(lang, `blog/${postSlug(post.entry.id)}`)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.entry.data.title,
  description: post.entry.data.description,
  datePublished: post.entry.data.date.toISOString(),
  inLanguage: contentLang,
  author: { '@type': 'Person', name: 'Vũ Tùng Minh', url: site.github },
  mainEntityOfPage: Astro.site ? new URL(path, Astro.site).href : path,
}
---

<Post
  lang={lang}
  contentLang={contentLang}
  title={post.entry.data.title}
  description={post.entry.data.description}
  date={post.entry.data.date}
  minutes={readingMinutes(post.entry.body)}
  origin={post.entry.data.origin}
  jsonLd={jsonLd}
>
  <Content />
</Post>
