---
// Pinned once in package.json; astro.config.mjs injects the version.
const cmsScript = `https://unpkg.com/@sveltia/cms@${__CMS_VERSION__}/dist/sveltia-cms.js`
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Nội dung · minh-vt</title>
    <link href="/admin/config.json" type="application/json" rel="cms-config-url" />
    <!-- Git-backed editor, no server. The version comes from package.json. -->
    <script is:inline src={cmsScript}></script>
  </head>
  <body>
    <noscript>Bật JavaScript để dùng trình soạn thảo.</noscript>
  </body>
</html>
