---
import labels from '@/admin/labels.json'
import { defaultLocale } from '@/i18n/locales'
import { local } from '@/i18n/utils'
import { site } from '@/lib/site'
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{labels.page.title} · {local(site.name, defaultLocale)}</title>
    <link rel="icon" href={site.icon.src} />
    <link href="/admin/config.json" type="application/json" rel="cms-config-url" />
  </head>
  <body>
    <noscript>{labels.page.noscript}</noscript>
  </body>
</html>

<script>
  // Bundled from the installed package, so the editor and its types are the
  // same version and nothing loads from a CDN. The config comes from the link.
  import CMS from '@sveltia/cms'

  void CMS.init()
</script>
