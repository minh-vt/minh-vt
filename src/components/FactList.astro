---
import type { CollectionEntry } from 'astro:content'
import { languages, type Lang } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'

export type FactRow = {
  id: string
  year: string
  title: string
  summary: string
  metric?: string
  refs: CollectionEntry<'references'>[]
}

interface Props {
  lang: Lang
  rows: FactRow[]
}

const { lang, rows } = Astro.props
const t = useTranslations(lang)
const monthYear = (date: Date) =>
  `${String(date.getMonth() + 1).padStart(2, '0')}/${date.getFullYear()}`
---

<ol class="mt-2">
  {
    rows.map((row, index) => (
      <li data-reveal style={`--reveal-delay:${Math.min(index, 5) * 40}ms`}>
        <details class="group border-b border-line">
          <summary class="bar-summary u-focus grid grid-cols-[1fr_auto] items-baseline gap-x-4 gap-y-0.5 py-4 md:grid-cols-[6rem_1fr_auto]">
            <span class="t-year col-span-2 md:col-span-1">{row.year}</span>
            <span class="t-title">{row.title}</span>
            <span class="t-year bar-marker" aria-hidden="true" />
          </summary>

          <div class="grid gap-x-4 gap-y-2 pb-6 md:grid-cols-[6rem_1fr]">
            <span class="hidden md:block" />
            <div>
              <p class="u-measure">{row.summary}</p>
              {row.metric && <p class="t-metric mt-3">{row.metric}</p>}
              {row.refs.length > 0 && (
                <p class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
                  {row.refs.map((ref) => (
                    <a
                      href={ref.data.url}
                      class="u-focus t-meta underline decoration-line underline-offset-4 hover:text-accent"
                      rel="noreferrer"
                    >
                      {ref.data.label ?? ref.data.outlet}
                      {ref.data.date ? ` · ${monthYear(ref.data.date)}` : ''}
                      <span class="sr-only"> ({languages[lang]})</span>
                    </a>
                  ))}
                </p>
              )}
            </div>
          </div>
        </details>
      </li>
    ))
  }
</ol>
<p class="t-meta mt-4">{t('timeline.hint')}</p>
