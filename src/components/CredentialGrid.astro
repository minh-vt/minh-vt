---
import CredentialCard from '@/components/CredentialCard.svelte'
import type { CredentialRow } from '@/lib/content'
import type { Lang } from '@/i18n/ui'

interface Props {
  lang: Lang
  items: CredentialRow[]
}

const { lang, items } = Astro.props
const years = [...new Set(items.map((item) => item.year))].sort((a, b) =>
  b.localeCompare(a),
)
---

<div class="mt-8 flex flex-col gap-12">
  {
    years.map((year) => (
      <section>
        <h2 class="t-year border-b border-line pb-3">{year}</h2>
        <ul class="mt-6 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {items
            .filter((item) => item.year === year)
            .map((item) => (
              <li class="min-w-0">
                <CredentialCard {item} {lang} />
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</div>
