---
import CredentialCard from '@/components/CredentialCard.astro'
import type { CredentialRow } from '@/lib/content'
import type { Lang } from '@/i18n/locales'

interface Props {
  lang: Lang
  items: CredentialRow[]
  /** The full page groups by year; the homepage excerpt is one row. */
  byYear?: boolean
}

const { lang, items, byYear = false } = Astro.props
const groups = byYear
  ? [...new Set(items.map((item) => item.year))]
      .sort((a, b) => b.localeCompare(a))
      .map((year) => ({ year, items: items.filter((item) => item.year === year) }))
  : [{ year: undefined, items }]
---

<div class="mt-6 flex flex-col gap-12">
  {
    groups.map((group) => (
      <section aria-label={group.year}>
        {group.year && (
          <h2 class="t-year mb-6 border-b border-line pb-3">{group.year}</h2>
        )}
        <ul class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {group.items.map((item) => (
            <li class="min-w-0">
              <CredentialCard {item} {lang} />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
