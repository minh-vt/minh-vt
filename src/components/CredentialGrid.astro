---
import type { CredentialRow } from '@/lib/content'
import type { Lang } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'

interface Props {
  lang: Lang
  items: CredentialRow[]
}

const { lang, items } = Astro.props
const t = useTranslations(lang)

/** One entry per year, newest first, so the grid reads as a record. */
const years = [...new Set(items.map((item) => item.year))].sort((a, b) =>
  b.localeCompare(a),
)
---

<div class="mt-6 flex flex-col gap-10">
  {
    years.map((year) => (
      <section>
        <h2 class="t-year border-b border-line pb-2">{year}</h2>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {items
            .filter((item) => item.year === year)
            .map((item, index) => (
              <li
                class="group border border-line bg-paper-raised p-4 transition-colors duration-200 hover:border-line-strong"
                data-reveal
                style={`--reveal-delay:${Math.min(index, 5) * 40}ms`}
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="t-title text-base">{item.title}</p>
                    <p class="t-meta mt-1">{item.issuer}</p>
                  </div>
                  {item.logo && (
                    <img
                      src={item.logo}
                      alt=""
                      width="20"
                      height="20"
                      loading="lazy"
                      class="mt-1 size-5 shrink-0"
                      aria-hidden="true"
                    />
                  )}
                </div>

                {item.file.endsWith('.png') ? (
                  <a href={item.file} class="u-focus mt-3 block" rel="noreferrer">
                    <img
                      src={item.file}
                      alt={item.title}
                      loading="lazy"
                      decoding="async"
                      class="w-full border border-line transition-opacity duration-200 group-hover:opacity-90"
                    />
                  </a>
                ) : (
                  <a
                    href={item.file}
                    class="u-focus t-meta mt-3 inline-flex items-center gap-1 underline decoration-line underline-offset-4 hover:text-accent"
                    rel="noreferrer"
                  >
                    {t('certs.open')} PDF
                    <span class="i-ph-arrow-up-right size-3" aria-hidden="true" />
                  </a>
                )}

                {item.extra && (
                  <a
                    href={item.extra}
                    class="u-focus t-meta mt-1 inline-flex items-center gap-1 underline decoration-line underline-offset-4 hover:text-accent"
                    rel="noreferrer"
                  >
                    PDF 2
                    <span class="i-ph-arrow-up-right size-3" aria-hidden="true" />
                  </a>
                )}
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</div>
