---
import { local, type Reference } from '@/lib/content'
import OutletMark from '@/components/OutletMark.astro'
import type { Lang } from '@/i18n/ui'

interface Props {
  lang: Lang
  items: Reference[]
}

const { lang, items } = Astro.props
const dateFormat = new Intl.DateTimeFormat(lang === 'vi' ? 'vi-VN' : 'en-GB', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
})
---

<ol class="mt-2">
  {
    items.map((row, index) => (
      <li
        class="grid gap-x-4 gap-y-1 border-b border-line py-3 md:grid-cols-[2rem_1.25rem_10rem_1fr_auto] md:items-baseline"
        data-reveal
        style={`--reveal-delay:${Math.min(index, 5) * 40}ms`}
      >
        <span class="t-meta opacity-60">{String(index + 1).padStart(2, '0')}</span>
        <span class="hidden md:flex md:items-center md:self-center">
          <OutletMark outlet={row.outlet} lang={lang} />
        </span>
        <span class="t-label">{local(row.outlet.data.name, lang)}</span>
        <a
          href={row.entry.data.url}
          class="u-focus underline decoration-line underline-offset-4 hover:text-accent"
          rel="noreferrer"
        >
          {row.entry.data.title}
          <span
            class="i-ph-arrow-up-right ml-1 inline-block size-3 text-ink-muted"
            aria-hidden="true"
          />
        </a>
        {row.entry.data.date ? (
          <time class="t-meta" datetime={row.entry.data.date.toISOString()}>
            {dateFormat.format(row.entry.data.date)}
          </time>
        ) : (
          <span />
        )}
      </li>
    ))
  }
</ol>
