---
import type { CollectionEntry } from 'astro:content'
import type { Lang } from '@/i18n/ui'

interface Props {
  lang: Lang
  items: CollectionEntry<'references'>[]
}

const { lang, items } = Astro.props
const dateFormat = new Intl.DateTimeFormat(lang === 'vi' ? 'vi-VN' : 'en-GB', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
})

/** A band of outlet names, cropped by both edges, drifting slowly. */
const outlets = [...new Set(items.map((item) => item.data.outlet))]
---

<div class="u-invert overflow-hidden py-5" aria-hidden="true">
  <div class="marquee">
    {
      [0, 1].map(() => (
        <div class="marquee__track">
          {outlets.map((outlet) => (
            <span class="t-label whitespace-nowrap text-paper opacity-80">
              {outlet}
              <span class="ml-10 opacity-40">●</span>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<ol class="u-wrap mt-6">
  {
    items.map((item, index) => (
      <li
        class="grid gap-x-4 gap-y-1 border-b border-line py-3 md:grid-cols-[2rem_10rem_1fr_auto] md:items-baseline"
        data-reveal
        style={`--reveal-delay:${Math.min(index, 5) * 40}ms`}
      >
        <span class="t-meta opacity-60">{String(index + 1).padStart(2, '0')}</span>
        <span class="t-label">{item.data.outlet}</span>
        <a
          href={item.data.url}
          class="u-focus underline decoration-line underline-offset-4 hover:text-accent"
          rel="noreferrer"
        >
          {item.data.title}
        </a>
        {item.data.date ? (
          <time class="t-meta" datetime={item.data.date.toISOString()}>
            {dateFormat.format(item.data.date)}
          </time>
        ) : (
          <span />
        )}
      </li>
    ))
  }
</ol>
