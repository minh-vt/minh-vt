---
import CredentialCard from '@/components/CredentialCard.svelte'
import { getCredential } from '@/lib/content'
import { defaultLocale, type Lang } from '@/i18n/ui'

interface Props {
  id: string
  lang?: Lang
}

const { id, lang = defaultLocale } = Astro.props
const item = await getCredential(id, lang)
---

<aside class="not-prose my-6 max-w-xs">
  <CredentialCard {item} {lang} />
</aside>
