---
import type { CollectionEntry } from 'astro:content'
import { useTranslations } from '../i18n/utils'
import type { Lang } from '../i18n/ui'

export type TimelineRow = {
  id: string
  year: string
  title: string
  summary: string
  metric?: string
  refs: CollectionEntry<'references'>[]
}

interface Props {
  lang: Lang
  rows: TimelineRow[]
}

const { lang, rows } = Astro.props
const t = useTranslations(lang)

function monthYear(date: Date): string {
  const month = String(date.getMonth() + 1).padStart(2, '0')
  return `${month}/${date.getFullYear()}`
}

// A label is only useful if it tells two links apart: prefer an explicit
// label, then outlet plus date, then the outlet on its own.
function refLabel(ref: CollectionEntry<'references'>, many: boolean): string {
  if (ref.data.label) return ref.data.label
  if (!many || !ref.data.date) return ref.data.outlet
  return `${ref.data.outlet} · ${monthYear(ref.data.date)}`
}
---

<section id="timeline" class="u-section u-wrap u-hairline scroll-mt-16">
  <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
    <h2 class="t-section">{t('section.timeline')}</h2>
    <p class="t-meta">{t('section.timeline.lead')}</p>
  </div>

  <ol class="mt-10">
    {
      rows.map((row) => (
        <li
          class="grid gap-x-8 gap-y-2 border-t border-line py-7 last:border-b md:grid-cols-[9.5rem_1fr]"
          data-reveal
        >
          <p class="t-year md:sticky md:top-20 md:w-fit md:self-start md:whitespace-nowrap">
            {row.year}
          </p>
          <div>
            <h3 class="t-title">{row.title}</h3>
            <p class="u-measure mt-2">{row.summary}</p>
            {row.metric && <p class="t-metric mt-3">{row.metric}</p>}
            {row.refs.length > 0 && (
              <p class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
                {row.refs.map((ref) => (
                  <a
                    href={ref.data.url}
                    class="u-focus t-meta underline decoration-line underline-offset-4 transition-colors duration-200 hover:text-accent hover:decoration-accent"
                    rel="noreferrer"
                  >
                    {refLabel(ref, row.refs.length > 1)}
                    <span aria-hidden="true"> ↗</span>
                  </a>
                ))}
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>
