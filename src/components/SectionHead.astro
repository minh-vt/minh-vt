---
interface Props {
  title: string
  lead?: string
  id?: string
}

const { title, lead, id } = Astro.props
---

<div
  id={id}
  class="flex scroll-mt-16 flex-col gap-1 border-t border-line pt-4 md:flex-row md:items-baseline md:justify-between md:gap-8"
>
  <h2 class="t-label">{title}</h2>
  {lead && <p class="t-meta">{lead}</p>}
</div>
