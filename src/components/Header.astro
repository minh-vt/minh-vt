---
import MobileNav from '@/components/MobileNav.svelte'
import ThemeToggle from '@/components/ThemeToggle.astro'
import { locales, type Lang } from '@/i18n/locales'
import { languageName, pathFor, switchLocalePath, useTranslations } from '@/i18n/utils'
import { siteFor } from '@/lib/site'
import { below } from '@/theme/breakpoints'

interface Props {
  lang: Lang
  /** Locales this page exists in; the others link to their homepage. */
  translations: readonly Lang[]
}

const { lang, translations } = Astro.props
const site = siteFor(lang)
const t = useTranslations(lang)
const others = locales
  .filter((locale) => locale !== lang)
  .map((locale) => ({
    lang: locale,
    href: translations.includes(locale)
      ? switchLocalePath(Astro.url.pathname, locale)
      : pathFor(locale),
  }))
const home = pathFor(lang)
const onHome = Astro.url.pathname === home

// The menu is the editor's list of area pages (site.menu). A link is current on
// its page and on every page below it.
const links = site.menu.map((area) => {
  const href = pathFor(lang, area)
  return {
    href,
    label: t(`area.${area}.title`),
    current: Astro.url.pathname.startsWith(href) ? ('page' as const) : undefined,
  }
})
---

<header
  class="site-header u-glass sticky top-0 z-30 border-b border-line"
  data-name-hidden={onHome ? '' : undefined}
>
  <div class="u-wrap flex h-[var(--header-height)] items-center justify-between gap-4">
    <a
      href={home}
      class="site-name link t-label text-sm text-ink"
      aria-current={onHome ? 'page' : undefined}
    >
      {site.name}
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label={t('nav.menu')}>
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.current} class="nav-link link text-sm">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      {
        others.map((other) => (
          <a
            href={other.href}
            hreflang={other.lang}
            lang={other.lang}
            class="btn btn-ghost btn-square text-sm"
            aria-label={`${t('lang.label')}: ${languageName(other.lang)}`}
          >
            {other.lang.toUpperCase()}
          </a>
        ))
      }
      <ThemeToggle
        label={t('theme.label')}
        lightLabel={t('theme.light')}
        darkLabel={t('theme.dark')}
      />
      <a href="#contact" class="btn ml-2 hidden md:inline-flex">{t('nav.contact')}</a>
      <div class="md:hidden">
        <MobileNav
          client:media={below('md')}
          links={[...links, { href: '#contact', label: t('nav.contact') }]}
          social={site.links}
          labels={{ open: t('nav.menu'), close: t('nav.close') }}
        />
      </div>
    </div>
  </div>
</header>

<script>
  import { onScroll } from '@/lib/scroll'

  const header = document.querySelector<HTMLElement>('.site-header')
  if (header) {
    // Step aside while reading down, come back on the way up; stay put while a
    // sheet is open, since the page underneath is locked.
    let last = window.scrollY
    onScroll(() => {
      const y = window.scrollY
      if (y !== last && !document.querySelector('dialog[open]')) {
        header.toggleAttribute('data-hidden', y > 80 && y > last)
      }
      last = y
    })

    // On the homepage the small name appears once the large one has left. The
    // server renders it hidden there, so it never flashes in.
    const hero = document.querySelector('[data-hero-name]')
    if (hero) {
      new IntersectionObserver(([entry]) => {
        header.toggleAttribute('data-name-hidden', entry.boundingClientRect.bottom > 0)
      }).observe(hero)
    }
  }
</script>
