---
import ThemeToggle from './ThemeToggle.svelte'
import { languages, type Lang } from '../i18n/ui'
import { localePath, switchLocalePath, useTranslations } from '../i18n/utils'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const other = lang === 'vi' ? 'en' : 'vi'
const switchHref = switchLocalePath(Astro.url.pathname, other)
const home = localePath(lang)
const writing = localePath(lang, 'blog')
---

<header class="sticky top-0 z-20 border-b border-line bg-paper">
  <div class="u-wrap flex h-14 items-center justify-between gap-4">
    <a
      href={home}
      class="u-focus t-label shrink-0 text-ink no-underline hover:text-accent"
      aria-current={Astro.url.pathname === home ? 'page' : undefined}
    >
      {t('site.name')}
    </a>

    <nav class="flex items-center gap-4 sm:gap-6" aria-label={t('nav.home')}>
      <a href={writing} class="u-focus t-label no-underline hover:text-accent">
        {t('nav.writing')}
      </a>
      <a
        href={`${home}#timeline`}
        class="u-focus t-label hidden no-underline hover:text-accent sm:inline"
      >
        {t('nav.timeline')}
      </a>
      <a
        href={`${home}#contact`}
        class="u-focus t-label hidden no-underline hover:text-accent sm:inline"
      >
        {t('nav.contact')}
      </a>

      <div class="flex items-center gap-2 border-l border-line pl-4 sm:gap-3">
        <a
          href={switchHref}
          hreflang={other}
          lang={other}
          class="u-focus t-label no-underline hover:text-accent"
          aria-label={`${t('lang.label')}: ${languages[other]}`}
        >
          {other.toUpperCase()}
        </a>
        <ThemeToggle
          client:idle
          label={t('theme.label')}
          lightLabel={t('theme.light')}
          darkLabel={t('theme.dark')}
        />
      </div>
    </nav>
  </div>
</header>
