---
import NavMenu from '@/components/NavMenu.svelte'
import ThemeToggle from '@/components/ThemeToggle.svelte'
import { type Lang } from '@/i18n/ui'
import { languageName, pathFor, switchLocalePath, useTranslations } from '@/i18n/utils'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const other = lang === 'vi' ? 'en' : 'vi'
const home = pathFor(lang)
const links = [
  { href: pathFor(lang, 'blog'), label: t('nav.writing') },
  { href: `${home}#timeline`, label: t('nav.timeline') },
  { href: `${home}#sources`, label: t('nav.sources') },
  { href: `${home}#contact`, label: t('nav.contact') },
]
const desktopLinks = links.slice(0, 3)
---

<header class="sticky top-0 z-20 border-b border-line bg-paper">
  <div class="u-wrap flex h-14 items-center justify-between gap-4">
    <a
      href={home}
      class="u-focus u-press t-label text-ink hover:text-accent"
      aria-current={Astro.url.pathname === home ? 'page' : undefined}
    >
      {t('site.name')}
    </a>

    <div class="flex items-center gap-2 sm:gap-4">
      <nav class="hidden items-center gap-5 sm:flex" aria-label={t('nav.menu')}>
        {
          desktopLinks.map((link) => (
            <a href={link.href} class="u-focus t-label text-ink-muted hover:text-accent">
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="relative sm:hidden">
        <NavMenu client:idle links={links} label={t('nav.menu')} />
      </div>

      <span class="hidden h-4 w-px bg-line sm:block"></span>

      <a
        href={switchLocalePath(Astro.url.pathname, other)}
        hreflang={other}
        lang={other}
        class="u-focus u-press t-label px-2 py-1 text-ink-muted hover:text-accent"
        aria-label={`${t('lang.label')}: ${languageName(other)}`}
      >
        {other.toUpperCase()}
      </a>

      <ThemeToggle
        client:idle
        label={t('theme.label')}
        lightLabel={t('theme.light')}
        darkLabel={t('theme.dark')}
      />
    </div>
  </div>
</header>
