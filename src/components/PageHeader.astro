---
import BackLink from '@/components/BackLink.astro'

interface Props {
  title: string
  lead?: string
  back: { href: string; label: string }
}

const { title, lead, back } = Astro.props
---

<!-- Every page below the homepage opens the same way: a way back, a title, a lead. -->
<header class="pt-10 md:pt-14">
  <BackLink {...back} />
  <h1 class="t-post mt-4">{title}</h1>
  {lead && <p class="t-lead mt-3 text-ink-muted">{lead}</p>}
</header>
