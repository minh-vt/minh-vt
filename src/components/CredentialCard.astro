---
import { Image } from 'astro:assets'
import type { Lang } from '@/i18n/locales'
import { pathFor } from '@/i18n/utils'
import type { CredentialRow } from '@/lib/content'
import { from } from '@/theme/breakpoints'

interface Props {
  item: CredentialRow
  lang: Lang
}

const { item, lang } = Astro.props
---

<!-- The card opens the credential's page, where the original file is offered. -->
<a href={pathFor(lang, `certs/${item.id}`)} class="preview-card group block text-ink">
  <span class="block aspect-[4/3] overflow-hidden border border-line bg-paper-raised p-3">
    <Image
      src={item.preview}
      alt=""
      width={520}
      sizes={`${from('lg')} 20rem, ${from('sm')} 45vw, 90vw`}
      class="size-full object-contain"
    />
  </span>
  <span class="t-title mt-3 block group-hover:underline">{item.title}</span>
  <span class="t-meta mt-1 block">{item.issuer} · {item.year}</span>
</a>

<style>
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .preview-card :global(img) {
      transition: transform var(--duration-ui) var(--ease-out);
    }

    .preview-card:hover :global(img) {
      transform: scale(1.02);
    }
  }
</style>
