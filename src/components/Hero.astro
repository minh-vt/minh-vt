---
import LinkIcon from '@/components/LinkIcon.svelte'
import Photo from '@/components/Photo.astro'
import type { Lang } from '@/i18n/locales'
import { local, useTranslations } from '@/i18n/utils'
import type { RoleRow } from '@/lib/content'
import { site } from '@/lib/site'
import { from } from '@/theme/breakpoints'

interface Props {
  lang: Lang
  roles: RoleRow[]
}

const { lang, roles } = Astro.props
const t = useTranslations(lang)
const name = local(site.name, lang)
// Animate letters, but keep each word intact when the name wraps on phones.
// Letters are numbered across words so the entrance runs left to right.
let index = 0
const words = name
  .split(' ')
  .map((word) => [...word].map((char) => ({ char, i: index++ })))
const contacts = [
  { kind: 'email' as const, label: site.email, url: `mailto:${site.email}` },
  ...site.links,
]
---

<!--
  No tagline: the name is the only headline, followed by facts. Every block is
  optional; without a portrait the grid simply drops that column.
-->
<section class="pt-6 md:pt-10">
  <div class="overflow-x-clip" data-hero-name>
    <h1 class="t-monument px-[var(--layout-gutter)]">
      {
        words.map((word) => (
          <>
            <span class="inline-block whitespace-nowrap" aria-hidden="true">
              {word.map(({ char, i }) => (
                <span class="char" style={`--i: ${i}`}>
                  {char}
                </span>
              ))}
            </span>{' '}
          </>
        ))
      }
      <span class="sr-only">{name}</span>
    </h1>
  </div>
  <script is:inline>
    // The name is the only entrance animation on the site, and it plays once
    // per visit: returning to the homepage should never make the reader wait.
    // Inline so the attribute lands before first paint; the motion itself is
    // CSS, which also honours reduced motion.
    {
      let seen = false
      try {
        seen = sessionStorage.getItem('hero-seen') === '1'
        sessionStorage.setItem('hero-seen', '1')
      } catch {
        // Storage blocked: play it, nothing else depends on the flag.
      }
      if (!seen)
        document.querySelector('[data-hero-name]')?.setAttribute('data-intro', '')
    }
  </script>

  <div
    class:list={[
      'u-wrap mt-8 grid items-start gap-x-8 gap-y-6 md:mt-12',
      site.portrait
        ? 'grid-cols-[6.5rem_1fr] sm:grid-cols-[9rem_1fr] md:grid-cols-[13rem_1fr_auto]'
        : 'md:grid-cols-[1fr_auto]',
    ]}
  >
    {
      site.portrait && (
        <Photo
          src={site.portrait}
          alt={name}
          widths={[104, 208, 416, 624]}
          sizes={`${from('md')} 13rem, ${from('sm')} 9rem, 6.5rem`}
          class="aspect-square w-full border border-line bg-paper-raised object-cover"
          priority
        />
      )
    }

    {
      roles.length > 0 && (
        <div>
          <p class="t-label">{t('hero.now')}</p>
          <ul class="mt-2 flex flex-col gap-2">
            {roles.map((role) => (
              <li class="t-hero-role">
                <span class="text-ink-muted">{role.role}, </span>
                {role.url ? (
                  <a href={role.url} class="link-text">
                    {role.org}
                    <span class="i-ph-arrow-up-right.5" aria-hidden="true" />
                  </a>
                ) : (
                  <span>{role.org}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <ul
      class:list={[
        'flex flex-wrap gap-x-5 md:flex-col md:items-start',
        site.portrait && 'col-span-2 md:col-span-1',
      ]}
    >
      {
        contacts.map((item) => (
          <li>
            <a
              href={item.url}
              rel={item.kind === 'email' ? undefined : 'me'}
              class="link text-sm"
            >
              <LinkIcon kind={item.kind} />
              {item.label}
            </a>
          </li>
        ))
      }
      {
        site.cv && (
          <li>
            <a href={site.cv} class="link text-sm">
              <span class="i-ph-file-arrow-down" aria-hidden="true" />
              {t('hero.cv')}
            </a>
          </li>
        )
      }
    </ul>
  </div>
</section>
