---
interface Props {
  lang: 'vi' | 'en'
  location: string
  lead: string
  name: string
  links: { href: string; label: string }[]
}

const { location, lead, name, links } = Astro.props
---

<section class="pt-6 md:pt-10">
  <div class="overflow-x-clip">
    <h1 class="t-monument px-[var(--layout-gutter)] text-center uppercase">{name}</h1>
  </div>

  <div
    class="u-wrap mt-8 flex flex-col gap-6 md:mt-10 md:flex-row md:items-end md:justify-between"
  >
    <div data-reveal>
      <p class="t-label flex items-center gap-2">
        <span class="inline-block size-1.5 bg-accent" aria-hidden="true"></span>
        {location}
      </p>
      <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="u-focus t-label text-ink hover:text-accent"
                rel={link.href.startsWith('http') ? 'me' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="t-lead u-measure" data-reveal>{lead}</p>
  </div>
</section>
