---
import { pathFor, useTranslations } from '@/i18n/utils'
import type { Lang } from '@/i18n/locales'

interface Props {
  lang: Lang
  location: string
  lead: string
  name: string
  links: { href: string; label: string }[]
}

const { lang, location, lead, name, links } = Astro.props
const t = useTranslations(lang)

// Animate letters, but keep each word intact when the name wraps on phones.
const words = name.split(' ')
---

<section class="pt-6 md:pt-10">
  <div class="overflow-x-clip">
    <h1 class="t-monument px-[var(--layout-gutter)] text-center uppercase">
      {
        words.map((word) => (
          <>
            <span class="inline-block whitespace-nowrap" aria-hidden="true">
              {[...word].map((char) => (
                <span class="char">{char}</span>
              ))}
            </span>{' '}
          </>
        ))
      }
      <span class="sr-only">{name}</span>
    </h1>
  </div>

  <div class="u-wrap mt-8 grid gap-6 md:mt-10 md:grid-cols-[1fr_2fr] md:gap-12">
    <div>
      <p class="t-label flex items-center gap-2">
        <span class="inline-block size-1.5 bg-accent" aria-hidden="true"></span>
        {location}
      </p>
      <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="u-focus u-link t-meta text-ink hover:text-accent"
                rel={link.href.startsWith('http') ? 'me' : undefined}
              >
                {link.label}
                <span
                  class="i-ph-arrow-up-right size-3 text-ink-muted"
                  aria-hidden="true"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="t-lead u-measure">{lead}</p>
      <div class="mt-4 flex flex-wrap gap-x-6 gap-y-1">
        <a
          href={`${pathFor(lang)}#work`}
          class="u-focus u-link text-accent underline decoration-line-strong"
        >
          {t('hero.work')}
          <span class="i-ph-arrow-down size-4" aria-hidden="true"></span>
        </a>
        <a
          href={pathFor(lang, 'blog')}
          class="u-focus u-link text-ink-muted underline decoration-line"
        >
          {t('hero.writing')}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // The name is the only entrance animation on the site.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (!reduced) {
    const { default: gsap } = await import('gsap')
    const motion = getComputedStyle(document.documentElement)
    gsap.from('.char', {
      opacity: 0,
      yPercent: 12,
      duration: parseFloat(motion.getPropertyValue('--duration-hero')) / 1000,
      ease: 'power3.out',
      stagger: parseFloat(motion.getPropertyValue('--stagger')) / 1000,
    })
  }
</script>
