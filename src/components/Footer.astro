---
import CopyEmail from '@/components/CopyEmail.astro'
import ContactLinks from '@/components/ContactLinks.astro'
import Monument from '@/components/Monument.astro'
import { siteFor } from '@/lib/site'
import { useTranslations, pathFor } from '@/i18n/utils'
import type { Lang } from '@/i18n/locales'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const site = siteFor(lang)
const t = useTranslations(lang)
const year = new Date().getFullYear()
const name = site.name
---

<!-- Contact closes every page, so a finished post ends where the homepage does. -->
<footer id="contact" class="u-invert scroll-mt-16 overflow-x-clip">
  <div class="u-wrap pt-14 md:pt-20">
    <p class="t-label">{t('section.contact')}</p>
    <a href={`mailto:${site.email}`} class="t-email mt-4 block w-fit py-1">
      {site.email}
    </a>
    <p class="mt-4 max-w-lg opacity-80">{t('section.contact.lead')}</p>

    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
      <CopyEmail
        email={site.email}
        label={t('contact.copy')}
        copiedLabel={t('contact.copied')}
      />
      <ul class="flex flex-wrap gap-x-5">
        <ContactLinks {lang} />
        <li>
          <a href={pathFor(lang, 'certs')} class="link text-sm">
            {t('area.certs.title')}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <Monument name={name} {lang} class="mt-14 select-none md:mt-20" />
  <p class="u-wrap t-meta pt-4 pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))]">
    {name} · {year}
  </p>
</footer>
