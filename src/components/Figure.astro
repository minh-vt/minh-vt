---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { from } from '@/theme/breakpoints'

interface Props {
  src: ImageMetadata
  alt: string
  caption?: string
}

/** A captioned image inside an article, at the width of the text column. */
const { src, alt, caption } = Astro.props
---

<figure class="my-8">
  <Image {src} {alt} width={672} sizes={`${from('md')} 42rem, 100vw`} />
  {caption && <figcaption class="t-meta mt-2">{caption}</figcaption>}
</figure>
