---
import type { ImageMetadata } from 'astro'
import Photo from '@/components/Photo.astro'
import { siteImage } from '@/lib/images'

interface Props {
  /** An imported image, or a path the CMS wrote, such as /media/photo.webp. */
  src: ImageMetadata | string
  alt: string
  caption?: string
  widths?: number[]
  sizes?: string
  priority?: boolean
}

/** A captioned image inside an article, built on Photo. */
const {
  src,
  alt,
  caption,
  widths = [480, 900, 1440],
  sizes = '(min-width: 48em) 40rem, 100vw',
  priority = false,
} = Astro.props
const image = typeof src === 'string' ? siteImage(src, `Figure "${alt}"`) : src
---

<figure class="my-8">
  <Photo src={image} {alt} {widths} {sizes} {priority} />
  {caption && <figcaption class="t-meta mt-2">{caption}</figcaption>}
</figure>
