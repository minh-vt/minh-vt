---
import 'katex/dist/katex.min.css'
import Base from '@/layouts/Base.astro'
import BackLink from '@/components/BackLink.astro'
import TocSheet from '@/components/TocSheet.svelte'
import type { MarkdownHeading } from 'astro'
import type { Lang } from '@/i18n/locales'
import { formatDate } from '@/i18n/format'
import { languageName, useTranslations, pathFor } from '@/i18n/utils'
import { postPath, type LocalizedPost } from '@/lib/content'

interface Props {
  lang: Lang
  contentLang: Lang
  title: string
  description: string
  date: Date
  minutes: number
  origin?: { label: string; url: string }
  jsonLd?: Record<string, unknown>
  headings: MarkdownHeading[]
  series?: { id: string; part: number }
  previous?: LocalizedPost
  next?: LocalizedPost
}

const {
  lang,
  contentLang,
  title,
  description,
  date,
  minutes,
  origin,
  jsonLd,
  headings,
  series,
  previous,
  next,
} = Astro.props
const t = useTranslations(lang)
// Short posts read fine without contents; the progress bar still shows.
const outline = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
const items = outline.length >= 3 ? outline : []
---

<Base lang={lang} {title} description={description} jsonLd={jsonLd}>
  <div class="read-progress" role="presentation" aria-hidden="true"></div>

  <div
    class:list={[
      'u-wrap pt-10 pb-16 md:pt-14 lg:grid lg:justify-center lg:gap-16',
      items.length > 0 && 'lg:grid-cols-[13rem_minmax(0,var(--measure))]',
    ]}
  >
    {
      items.length > 0 && (
        <aside class="hidden lg:block">
          <nav aria-label={t('blog.toc')} class="toc-aside">
            <p class="t-label">{t('blog.toc')}</p>
            <ol class="mt-3 border-l border-line" lang={contentLang}>
              {items.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    data-toc-link={heading.slug}
                    class:list={[
                      'toc-link block py-1.5 pr-2 text-sm',
                      heading.depth === 3 ? 'pl-7' : 'pl-4',
                    ]}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )
    }

    <article class="u-measure mx-auto w-full lg:mx-0">
      <BackLink href={pathFor(lang, 'blog')} label={t('area.blog.title')} />

      <header class="mt-6">
        {
          series && (
            <p class="t-label">
              {t('blog.part')} {series.part}
            </p>
          )
        }
        <h1 class="t-post mt-1" lang={contentLang}>{title}</h1>
        <p class="t-lead mt-3" lang={contentLang}>{description}</p>
        <p class="t-meta mt-4">
          <time datetime={date.toISOString()}>{formatDate(date, lang, 'day')}</time>
          <span aria-hidden="true"> · </span>
          {minutes}{' '}{t('blog.reading')}
          {
            contentLang !== lang && (
              <>
                <span aria-hidden="true"> · </span>
                {t('blog.inLanguage')} {languageName(contentLang)}
              </>
            )
          }
        </p>
        {
          origin && (
            <p class="t-meta mt-1">
              {t('blog.origin')}{' '}
              <a href={origin.url} class="link-text text-ink">
                {origin.label}
              </a>
            </p>
          )
        }
      </header>

      <div class="prose mt-10" lang={contentLang}>
        <slot />
      </div>

      {
        (previous || next) && (
          <nav class="mt-14 grid gap-4 border-t border-line pt-6 sm:grid-cols-2">
            {previous ? (
              <a href={postPath(lang, previous.entry.id)} class="group block">
                <span class="t-label">← {t('blog.prev')}</span>
                <span
                  class="t-title mt-1 block group-hover:underline"
                  lang={previous.lang}
                >
                  {previous.entry.data.title}
                </span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a href={postPath(lang, next.entry.id)} class="group block sm:text-right">
                <span class="t-label">{t('blog.next')} →</span>
                <span class="t-title mt-1 block group-hover:underline" lang={next.lang}>
                  {next.entry.data.title}
                </span>
              </a>
            )}
          </nav>
        )
      }
    </article>
  </div>

  {
    items.length > 0 && (
      <div slot="dock" class="lg:hidden">
        <TocSheet
          client:media="(max-width: 71.99em)"
          items={items.map(({ slug, text, depth }) => ({ slug, text, depth }))}
          labels={{ toc: t('blog.toc'), close: t('nav.close') }}
        />
      </div>
    )
  }
</Base>

<script>
  import { gsap, markCurrent, ScrollTrigger } from '@/lib/scroll'

  // Long code and formulas keep their own horizontal scroll, including keyboard.
  const overflow = new ResizeObserver((entries) => {
    for (const { target } of entries) {
      if (target.scrollWidth > target.clientWidth) target.setAttribute('tabindex', '0')
      else target.removeAttribute('tabindex')
    }
  })
  document
    .querySelectorAll('.prose pre, .katex-display')
    .forEach((element) => overflow.observe(element))

  // Reading progress: CSS scroll timelines where supported, ScrollTrigger otherwise.
  const bar = document.querySelector('.read-progress')
  if (bar && !CSS.supports('animation-timeline: scroll()')) {
    gsap.fromTo(
      bar,
      { scaleX: 0 },
      { scaleX: 1, ease: 'none', scrollTrigger: { start: 0, end: 'max', scrub: true } },
    )
  }

  // Mark the heading being read in both contents lists, top to bottom. The
  // sheet's links render later, so they are looked up each time.
  const headings = [...document.querySelectorAll<HTMLElement>('.prose :is(h2, h3)[id]')]
  headings.forEach((heading, index) => {
    const next = headings[index + 1]
    ScrollTrigger.create({
      trigger: heading,
      start: 'top 30%',
      endTrigger: next ?? '.prose',
      end: next ? 'top 30%' : 'bottom 30%',
      onToggle: (self) => {
        if (!self.isActive) return
        const links = document.querySelectorAll<HTMLElement>('[data-toc-link]')
        markCurrent(links, (link) => link.dataset.tocLink === heading.id)
      },
    })
  })
  // Fonts, images and formulas change the layout after load.
  window.addEventListener('load', () => ScrollTrigger.refresh())
</script>
