---
import '@fontsource-variable/space-grotesk'
import '@fontsource-variable/ibm-plex-sans'
import '@/styles/global.css'
import 'katex/dist/katex.min.css'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { useTranslations } from '@/i18n/utils'
import { type Lang } from '@/i18n/ui'
import { chromeColor } from '@/theme/browser-chrome'

interface Props {
  lang: Lang
  title: string
  description: string
  /** Structured data for this page, serialised as JSON-LD. */
  jsonLd?: Record<string, unknown>
  noindex?: boolean
}

const { lang, title, description, jsonLd, noindex = false } = Astro.props
const t = useTranslations(lang)
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname

// Same page in the other locale, derived from the path rather than a regex.
const rest = Astro.url.pathname.split('/').filter(Boolean).slice(1).join('/')
const alternate = (target: Lang) =>
  Astro.site ? new URL(`/${target}/${rest}`, Astro.site).href : `/${target}/${rest}`
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      name="theme-color"
      content={chromeColor.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={chromeColor.dark}
      media="(prefers-color-scheme: dark)"
    />
    <meta
      property="og:type"
      content={jsonLd?.['@type'] === 'BlogPosting' ? 'article' : 'website'}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" hreflang="vi" href={alternate('vi')} />
    <link rel="alternate" hreflang="en" href={alternate('en')} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      // Runs before first paint so the stored theme never flashes.
      document.documentElement.classList.add('js')
      try {
        const stored = localStorage.getItem('theme')
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.dataset.theme =
          stored ?? (prefersDark ? 'dark' : 'light')
      } catch {
        document.documentElement.dataset.theme = 'light'
      }
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="u-focus sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-paper focus:px-4 focus:py-2 focus:text-sm"
    >
      {t('nav.skip')}
    </a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Entrance animation, one implementation for the whole site. GSAP's
      // ScrollTrigger replaces the hand-written IntersectionObserver: it gives
      // the same "once" behaviour plus a timeline we can extend later.
      import gsap from 'gsap'
      import { ScrollTrigger } from 'gsap/ScrollTrigger'

      gsap.registerPlugin(ScrollTrigger)

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const nodes = Array.from(document.querySelectorAll('[data-reveal]'))

      if (!reduced) {
        gsap.from('.char', {
          opacity: 0,
          yPercent: 18,
          duration: 0.62,
          ease: 'power3.out',
          stagger: 0.026,
        })
      }

      for (const node of nodes) {
        if (node instanceof HTMLElement && node.dataset.reveal === 'clip') {
          node.setAttribute('data-revealed', '')
          continue
        }

        if (reduced) continue

        gsap.from(node, {
          opacity: 0,
          y: 12,
          duration: 0.36,
          ease: 'power3.out',
          scrollTrigger: { trigger: node, start: 'top 88%', once: true },
        })
      }
    </script>
  </body>
</html>
