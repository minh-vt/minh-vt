---
import '@fontsource-variable/space-grotesk'
import '@fontsource-variable/ibm-plex-sans'
import '@/styles/global.css'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { local, switchLocalePath, useTranslations } from '@/i18n/utils'
import { site } from '@/lib/site'
import { locales, type Lang } from '@/i18n/locales'
import { chromeColor } from '@/theme/browser-chrome'

interface Props {
  lang: Lang
  /** The page's own title; the site name is appended here, once. Omit on the homepage. */
  title?: string
  description: string
  /** Structured data for this page, serialised as JSON-LD. */
  jsonLd?: Record<string, unknown>
  noindex?: boolean
}

const { lang, title, description, jsonLd, noindex = false } = Astro.props
const t = useTranslations(lang)
const siteName = local(site.name, lang)
const fullTitle = title ? `${title} · ${siteName}` : siteName
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname

// Same page in the other locale, derived from the path rather than a regex.
const alternate = (target: Lang) => {
  const path = switchLocalePath(Astro.url.pathname, target)
  return Astro.site ? new URL(path, Astro.site).href : path
}
// `</script>` inside a string would end the tag early, so escape every `<`.
const jsonLdHtml = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c')
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      name="theme-color"
      content={chromeColor.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={chromeColor.dark}
      media="(prefers-color-scheme: dark)"
    />
    <meta
      property="og:type"
      content={jsonLd?.['@type'] === 'BlogPosting' ? 'article' : 'website'}
    />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    {
      locales.map((locale) => (
        <link rel="alternate" hreflang={locale} href={alternate(locale)} />
      ))
    }
    {jsonLdHtml && <script type="application/ld+json" set:html={jsonLdHtml} />}

    <script is:inline>
      // Runs before first paint so the stored theme never flashes.
      try {
        const stored = localStorage.getItem('theme')
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.dataset.theme =
          stored ?? (prefersDark ? 'dark' : 'light')
      } catch {
        document.documentElement.dataset.theme = 'light'
      }
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-paper focus:px-4 focus:py-2 focus:text-sm"
    >
      {t('nav.skip')}
    </a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Every page gets the same dock in the thumb zone; pages may add to it. -->
    <div class="dock flex gap-2">
      <slot name="dock" />
      <a href="#top" class="btn btn-square u-glass" aria-label={t('nav.top')}>
        <span class="i-ph-arrow-up" aria-hidden="true"></span>
      </a>
    </div>
  </body>
</html>

<script>
  import { ScrollTrigger } from '@/lib/scroll'

  // The dock appears once the reader is a screen down, on any page long enough.
  const dock = document.querySelector<HTMLElement>('.dock')
  if (dock) {
    ScrollTrigger.create({
      start: () => window.innerHeight,
      end: 'max',
      onToggle: (self) => dock.toggleAttribute('data-visible', self.isActive),
    })
  }
</script>
