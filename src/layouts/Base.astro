---
import '@/styles/global.css'
import type { ImageMetadata } from 'astro'
import { Font, getImage } from 'astro:assets'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { local, pathFor, switchLocalePath, useTranslations } from '@/i18n/utils'
import { site } from '@/lib/site'
import { absolute, jsonLd as serialise, ogLocale, shareImage } from '@/lib/seo'
import { defaultLocale, locales, type Lang } from '@/i18n/locales'
import { chromeColor } from '@/theme/browser-chrome'

interface Props {
  lang: Lang
  /** The page's own title; the site name is appended here, once. Omit on the homepage. */
  title?: string
  description: string
  /** Structured data for this page, serialised as JSON-LD. */
  jsonLd?: Record<string, unknown>
  /** Shown when the page is shared; the site's share image otherwise. */
  image?: ImageMetadata
  /**
   * Locales this page is written in. A page shown in another locale (an
   * untranslated post under /en/) points its canonical at the original.
   */
  translations?: readonly Lang[]
  noindex?: boolean
}

const {
  lang,
  title,
  description,
  jsonLd,
  image,
  translations = locales,
  noindex = false,
} = Astro.props
const t = useTranslations(lang)
const siteName = local(site.name, lang)
const fullTitle = title ? `${title} · ${siteName}` : siteName

// Same page in another locale, derived from the path rather than a regex.
const alternate = (target: Lang) => absolute(switchLocalePath(Astro.url.pathname, target))
const canonical = alternate(translations.includes(lang) ? lang : translations[0])
const xDefault = translations.includes(defaultLocale) ? defaultLocale : translations[0]

const share = image ?? site.shareImage ?? site.portrait
const og = share && (await shareImage(share))
const structured = jsonLd && serialise(jsonLd)

// One icon from the CMS: as it is for the tab, as a 180px PNG for home screens.
const iconType =
  site.icon.format === 'svg' ? 'image/svg+xml' : `image/${site.icon.format}`
const touchIcon = await getImage({
  src: site.icon,
  width: 180,
  height: 180,
  format: 'png',
})
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <Font cssVariable="--font-grotesk" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-plex" preload={[{ subset: 'latin' }]} />
    <link rel="icon" href={site.icon.src} type={iconType} />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteName} · ${t('area.blog.title')}`}
      href={`${pathFor(lang)}rss.xml`}
    />
    {
      (['light', 'dark'] as const).map((theme) => (
        <meta
          name="theme-color"
          content={chromeColor[theme]}
          media={`(prefers-color-scheme: ${theme})`}
          data-theme-color={theme}
        />
      ))
    }
    <meta
      property="og:type"
      content={jsonLd?.['@type'] === 'BlogPosting' ? 'article' : 'website'}
    />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale(lang)} />
    {
      translations
        .filter((locale) => locale !== lang)
        .map((locale) => (
          <meta property="og:locale:alternate" content={ogLocale(locale)} />
        ))
    }
    {
      og && (
        <>
          <meta property="og:image" content={og.url} />
          <meta property="og:image:width" content={String(og.width)} />
          <meta property="og:image:height" content={String(og.height)} />
          <meta property="og:image:alt" content={title ?? siteName} />
        </>
      )
    }
    <meta name="twitter:card" content={og?.wide ? 'summary_large_image' : 'summary'} />
    {
      translations.length > 1 && (
        <>
          {translations.map((locale) => (
            <link rel="alternate" hreflang={locale} href={alternate(locale)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={alternate(xDefault)} />
        </>
      )
    }
    {structured && <script type="application/ld+json" set:html={structured} />}
    <slot name="head" />

    <script is:inline>
      // Runs before first paint so the stored theme never flashes.
      try {
        const stored = localStorage.getItem('theme')
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.dataset.theme =
          stored ?? (prefersDark ? 'dark' : 'light')
      } catch {
        document.documentElement.dataset.theme = 'light'
      }
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-paper focus:px-4 focus:py-2 focus:text-sm"
    >
      {t('nav.skip')}
    </a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Every page gets the same dock in the thumb zone; pages may add to it. -->
    <div class="dock flex gap-2">
      <slot name="dock" />
      <a href="#top" class="btn btn-square u-glass" aria-label={t('nav.top')}>
        <span class="i-ph-arrow-up" aria-hidden="true"></span>
      </a>
    </div>
  </body>
</html>

<script>
  import { onScroll } from '@/lib/scroll'

  // The dock appears once the reader is a screen down, on any page long enough.
  const dock = document.querySelector<HTMLElement>('.dock')
  if (dock) {
    onScroll(() =>
      dock.toggleAttribute('data-visible', window.scrollY > window.innerHeight),
    )
  }
</script>
