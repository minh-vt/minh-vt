    "@astrojs/svelte": "9.1.6",
    "@sveltia/cms": "0.261.0",
    "astro": "7.4.13",
    "katex": "^0.19.1",
    "mdast-util-to-markdown": "^2.2.3",
    "melt": "^0.44.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "svelte": "^5.57.3",
    "unist-util-visit": "^5.2.0"
