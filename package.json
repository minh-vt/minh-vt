{
  "name": "minh-vt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bunx --bun astro dev",
    "build": "bunx --bun astro build",
    "preview": "bunx --bun astro preview",
    "readme": "bun scripts/readme.ts",
    "check": "bunx --bun astro check && bunx --bun svelte-check --tsconfig ./tsconfig.json && bunx --bun eslint . && bun test tests",
