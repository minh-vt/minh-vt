    "prettier-plugin-svelte": "^4.1.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.5",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
