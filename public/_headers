# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).

# Build output: every file name carries a content hash, so it never changes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The profile README is for GitHub; the page itself should not be indexed.
/README.md
  X-Robots-Tag: noindex
